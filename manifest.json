{
  "manifest_version": 2,
  "name": "Better Read Aloud",
  "version": "0.3.0",
  "description": "Makes Zotero's Read Aloud skip manuscript line numbers, rejoin hyphenated words, and speak math in words.",
  "author": "Zachary Ferguson",
  "homepage_url": "https://github.com/zfergus/zotero-better-read-aloud",
  "applications": {
    "zotero": {
      "id": "skip-line-numbers@zfergus.github.io",
      "update_url": "https://github.com/zfergus/zotero-better-read-aloud/releases/latest/download/updates.json",
      "strict_min_version": "10.0",
      "strict_max_version": "11.*"
    }
  }
}
